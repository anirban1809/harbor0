# Only the loopback development entrypoint reads DEV_AUTH.
DEV_AUTH=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TABLE_NAME=harbor-local
DYNAMODB_ENDPOINT=http://127.0.0.1:8100
R2_BUCKET=harbor-local
R2_ENDPOINT=http://127.0.0.1:9100
R2_ACCESS_KEY_ID=local-storage
R2_SECRET_ACCESS_KEY=local-development-secret
PORT=8787
# Production Lambda uses R2_SECRET_ARN instead of raw R2 credentials.
# Web app environment: see apps/web/.env.example
