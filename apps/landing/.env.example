# Where "Sign up" and "Sign in" send people: the web app's origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Turns on the pricing page's plan buttons, which open checkout in the app.
NEXT_PUBLIC_CHECKOUT=false
# The API itself (not the app's /api), for the pricing page's custom-plan form.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
# The staff-console form custom-plan requests go to; unset leaves a plain email link.
NEXT_PUBLIC_CUSTOM_PLAN_FORM=
