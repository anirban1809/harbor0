{
  "name": "harbor-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-app-icons.mjs && tsx scripts/generate-social-preview.tsx",
    "dev": "tsx --env-file=.env apps/backend/src/local.ts",
    "dev:web": "npm run dev -w @harbor/web",
    "dev:landing": "npm run dev -w @harbor/landing",
    "dev:desktop": "npm run dev -w @harbor/desktop",
    "dev:admin": "npm run dev -w @harbor/admin",
    "typecheck": "tsc --noEmit && npm run typecheck -w @harbor/web && npm run typecheck -w @harbor/landing && npm run typecheck -w @harbor/admin",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build": "tsx scripts/build.ts && npm run build -w @harbor/web && npm run build -w @harbor/desktop",
    "build:backend": "tsx scripts/build.ts",
    "openapi": "tsx scripts/openapi.ts",
    "infra:synth": "cdk synth --app 'npx tsx infra/app.ts'",
    "local:setup": "tsx --env-file=.env scripts/local-setup.ts",
    "test:integration": "RUN_INTEGRATION=true vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "npm run build -w @harbor/desktop && tsx scripts/desktop-smoke.ts",
    "test:desktop:functional": "tsx scripts/desktop-functional.ts",
    "test:desktop:resilience": "tsx scripts/desktop-resilience.ts",
    "test:desktop:auth-ui": "tsx scripts/desktop-auth-and-ui.ts",
    "test:sync": "tsx scripts/sync-integration.ts",
    "r2:provision": "tsx scripts/provision-r2.ts",
    "cloud:deploy": "tsx --env-file=.env.cloud scripts/deploy-cloud.ts",
    "cloud:validate-r2": "tsx --env-file=.env.cloud scripts/validate-r2.ts",
    "cloud:validate": "tsx --env-file=.env.cloud scripts/validate-cloud.ts",
    "cloud:validate-web": "tsx --env-file=.env.cloud scripts/validate-live-web.ts",
    "build:web-static": "tsx scripts/build-web-static.ts",
    "build:landing": "npm run build -w @harbor/landing",
    "build:admin": "npm run build -w @harbor/admin",
    "cloud:deploy-web": "tsx --env-file=.env.cloud scripts/deploy-web.ts",
    "cloud:dashboard": "tsx --env-file=.env.cloud scripts/ops-dashboard.ts",
    "cloud:validate-hosting": "tsx --env-file=.env.cloud scripts/validate-web-hosting.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:ui": "tsx scripts/ui-redesign-check.ts",
    "test:previews": "npm run build -w @harbor/desktop && tsx scripts/preview-check.ts",
    "test:web-styles": "tsx scripts/web-styles-check.ts",
    "cloud:deploy-web:assets": "tsx --env-file=.env.cloud scripts/deploy-web.ts --assets-only",
    "cloud:deploy-admin": "tsx --env-file=.env.cloud scripts/deploy-admin.ts",
    "cloud:deploy-admin:assets": "tsx --env-file=.env.cloud scripts/deploy-admin.ts --assets-only",
    "admin:staff": "tsx --env-file=.env.cloud scripts/admin-staff.ts",
    "cloud:deploy-landing": "tsx --env-file=.env.cloud scripts/deploy-landing.ts",
    "cloud:deploy-landing:assets": "tsx --env-file=.env.cloud scripts/deploy-landing.ts --assets-only",
    "staging:r2:provision": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/provision-r2.ts",
    "staging:deploy": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/deploy-cloud.ts",
    "staging:deploy-web": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/deploy-web.ts",
    "staging:deploy-web:assets": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/deploy-web.ts --assets-only",
    "staging:deploy-admin": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/deploy-admin.ts",
    "staging:deploy-admin:assets": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/deploy-admin.ts --assets-only",
    "staging:admin-staff": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/admin-staff.ts",
    "staging:validate": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/validate-cloud.ts",
    "staging:validate-web": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/validate-live-web.ts",
    "staging:dashboard": "HARBOR_ENV=staging tsx --env-file=.env.staging scripts/ops-dashboard.ts",
    "infra:synth:staging": "HARBOR_ENV=staging cdk synth --app 'npx tsx infra/app.ts'",
    "test:drive": "npm run build -w @harbor/desktop && tsx scripts/drive-redesign-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1144.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-lambda": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@aws-sdk/client-sesv2": "^3.1140.0",
    "@aws-sdk/lib-dynamodb": "^3.1140.0",
    "@aws-sdk/s3-request-presigner": "^3.1140.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@tanstack/react-query": "^5.103.2",
    "aws-cdk-lib": "^2.270.0",
    "aws-jwt-verify": "^5.2.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "constructs": "^10.8.1",
    "hash-wasm": "^4.12.0",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@zip.js/zip.js": "^2.18.2",
    "aws-cdk": "^2.1143.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "ws": "^8.22.0"
  }
}
