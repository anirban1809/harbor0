# Staging deployment settings. Copy to .env.staging (git-ignored) and fill in.
# Every value here must be staging's own: its own R2 bucket and bucket-scoped keys, never production's.
HARBOR_ENV=staging
AWS_REGION=us-east-1

# Cloudflare: provisioning the staging bucket and updating its CORS rule.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# A dedicated private bucket (npm run staging:r2:provision creates it) and S3 keys scoped to it.
R2_BUCKET=harbor-files-staging
R2_ENDPOINT=https://ACCOUNT_ID.us.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Browser origin of the staging web app. npm run staging:deploy-web rewrites this with the
# deployed URL (the CloudFront hostname, or https://$WEB_DOMAIN once WEB_CERT_ARN is set).
WEB_ORIGIN=https://staging.harbor0.com
WEB_DOMAIN=staging.harbor0.com
WEB_CERT_ARN=

EMAIL_FROM=

# Optional staging management console (npm run staging:deploy-admin fills ADMIN_ORIGIN).
ADMIN_ORIGIN=
ADMIN_DOMAIN=
ADMIN_CERT_ARN=
